# JobScout Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (Neon PostgreSQL in production)
# ===========================================
# Local development (Docker):
DATABASE_URL="postgresql://jobscout:jobscout_dev@localhost:5432/jobscout"
# Direct URL for migrations (same as DATABASE_URL for local):
DIRECT_URL="postgresql://jobscout:jobscout_dev@localhost:5432/jobscout"

# Production (Neon):
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/jobscout?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/jobscout?sslmode=require"

# ===========================================
# CACHE (Upstash Redis in production)
# ===========================================
# Local development (Docker):
REDIS_URL="redis://localhost:6379"

# Production (Upstash):
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# ===========================================
# API SERVER
# ===========================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ===========================================
# WEB APP (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# STORAGE (Cloudflare R2 - optional)
# ===========================================
# R2_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="xxx"
# R2_SECRET_ACCESS_KEY="xxx"
# R2_BUCKET_NAME="jobscout"

# ===========================================
# ERROR TRACKING (Sentry - optional)
# ===========================================
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ===========================================
# SCRAPER
# ===========================================
# SCRAPER_DRY_RUN=false
# SCRAPER_RATE_LIMIT=2
